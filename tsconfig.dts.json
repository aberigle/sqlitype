{
  "extends": "./tsconfig.json",
  "exclude": [
    "node_modules",
    "**/node_modules/**",
    "**/__test__/**",
    "**/*.test.ts",
    "dist",
    "build.ts"
  ],
  "compilerOptions": {
    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": "./dist",
    "moduleResolution": "node",
    "baseUrl": ".",
  }
}