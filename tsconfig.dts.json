{
  "extends": "./tsconfig.json",
  "exclude": [
    "node_modules",
    "**/node_modules/**",
    "**/__test__/**",
    "**/*.test.ts",
    "dist",
    "build.ts",
    "mcp",
    "example"
  ],
  "compilerOptions": {
    "noEmit": false,
    "strict": false,
    "verbatimModuleSyntax": false,
    "noUncheckedIndexedAccess": false,
    "noImplicitOverride": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": "./dist",
    "allowImportingTsExtensions": false
  }
}